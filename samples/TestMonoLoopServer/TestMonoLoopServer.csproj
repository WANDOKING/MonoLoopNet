<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MonoLoop.Server\MonoLoop.Server.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <BuildTime>$([System.DateTime]::UtcNow.ToString("o"))</BuildTime>
    <BuildHost>$([System.Environment]::MachineName)</BuildHost>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="BuildTime" Value="$(BuildTime)" />
    <AssemblyMetadata Include="BuildHost" Value="$(BuildHost)" />
  </ItemGroup>
  
</Project>
